  "allow": [
    {
      "name": "git-readonly",
      "pattern": "^(?:git\\s+status(?:\\s+(?:--[a-zA-Z0-9_-]+(?:=[a-zA-Z0-9_.-]+)?|-[a-zA-Z0-9]+|\\d+|[a-zA-Z0-9_./@~-]+))*|git\\s+branch(?:\\s+(?:-a|-r|--list|-v))*|git\\s+(?:diff|log)(?!\\s*.*(?:^|\\s)(?:--[a-zA-Z0-9_-]*(?:output|out\\b|file)[a-zA-Z0-9_-]*|-[oO]\\b|-[oO]=|-[oO]\\S|--[a-zA-Z0-9_-]+=[^\\s]*[\\\\/.]))(?:\\s+(?:--[a-zA-Z0-9_-]+(?:=[a-zA-Z0-9_.-]+)?|-[a-zA-Z0-9]+|\\d+|[a-zA-Z0-9_./@~-]+))*)$",
      "delay": 3
    },
    {
      "name": "file-list",
      "pattern": "^(?:pwd|Get-Location|(?:ls|dir|Get-ChildItem)(?:\\s+(?!.*\\.\\.)(?![\\/\\\\]|[a-zA-Z]:)(?:-[a-zA-Z0-9]+|['\"]?(?:\\.[\\/\\\\])?[a-zA-Z0-9_@~.-]+(?:[\\/\\\\][a-zA-Z0-9_@~.-]+)*['\"]?))*)$",
      "delay": 3
    },
    {
      "name": "version-check",
      "pattern": "^(?:npm|node)\\s+(?:--version|-v)$",
      "delay": 3
    },
    {
      "name": "echo-safe",
      "pattern": "^echo(?:\\s+[^;&|><`$()\\r\\n]+)?$",
      "delay": 3
    },
    {
      "name": "npm-build",
      "_comment": "Tier 2: disabled",
      "pattern": "^npm run build$",
      "delay": 3,
      "enabled": false
    },
    {
      "name": "npm-lint",
      "_comment": "Tier 2: disabled",
      "pattern": "^npm run lint$",
      "delay": 3,
      "enabled": false
    },
    {
      "name": "npm-dev",
      "_comment": "Tier 2: disabled",
      "pattern": "^npm run dev$",
      "delay": 3,
      "enabled": false
    },
    {
      "name": "npm-test",
      "_comment": "Tier 2: disabled",
      "pattern": "^npm test$",
      "delay": 3,
      "enabled": false
    }
  ],
  "optionRules": [
    {
      "name": "always-in-conversation",
      "startsWith": "Yes, and always allow in this conversation",
      "enabled": true,
      "allowPersist": false
    },
    {
      "name": "custom-rule-2",
      "startsWith": "Yes, allow creation",
      "commandStartsWith": "Yes, allow creation",
      "enabled": true,
      "allowPersist": false
    },
    {
      "name": "custom-rule-3",
      "startsWith": "Yes, accept this change",
      "commandStartsWith": "Yes, accept this change",
      "enabled": true,
      "allowPersist": false
    }
  ]
}