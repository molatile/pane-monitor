{
  "defaultDelaySeconds": 3,
  "deny": [
    "rm -rf",
    "rmdir /s",
    "del /f",
    "Remove-Item -Recurse",
    "git push --force",
    "git reset --hard",
    "curl.*\\|.*(?:sh|bash|zsh|powershell|cmd|pwsh)",
    "wget.*\\|.*(?:sh|bash|zsh|powershell|cmd|pwsh)",
    "powershell -enc",
    "sudo",
    "chmod 777",
    ".env",
    "settings.json",
    ".ssh",
    "credentials"
  ],
  "danger": [
    {
      "text": "delete",
      "wholeWord": false,
      "level": "hard",
      "enabled": true
    },
    {
