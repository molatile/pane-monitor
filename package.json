    "test:danger": "node tests/test-danger.js",
    "test:unit": "node tests/test-unit.js",
    "test:agentwatch": "node tests/test-agentwatch.js",
    "test:rules": "node tests/test-rules.js",
    "test:dash": "node tests/test-dashboard.js",
    "test:integration": "node tests/test-integration.js",
    "test:fast": "node tests/test-fast-prompt.js",
    "test:gui": "node tests/test-gui.js",
    "test:stage3a": "node tests/test-stage3a.js",
    "test:stage3b": "node tests/test-stage3b.js",
    "test:stage4": "node tests/test-stage4.js",
    "test:stage4b": "node tests/test-stage4b.js",
    "test:stage4c": "node tests/test-stage4c.js",
    "test:stage4d": "node tests/test-stage4d.js",
    "test:stage5": "node tests/test-stage5.js",
    "test:stage6": "node tests/test-stage6.js",
    "test:unselect": "node tests/test-gui-unselect.js",
    "test:lifecycle": "node tests/test-gui-lifecycle.js",
    "test:all": "npm test && npm run test:gui && npm run test:lifecycle && npm run test:stage3a && npm run test:stage3b && npm run test:stage4 && npm run test:stage4b && npm run test:stage4c && npm run test:stage4d && npm run test:stage5 && npm run test:stage6 && npm run test:unselect && npm run test:fast && npm run test:integration",
    "dash": "node bin/agentwatch.js dash",
    "gui": "node bin/agentwatch.js gui"
  },
  "keywords": [
    "pty",
    "conpty",
    "terminal",
    "agentwatch",
    "antigravity",
    "monitor"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^44.9.0"
  }
}
