{
  "name": "agentwatch",
  "version": "1.0.0",
  "description": "Terminal monitor and permission prompt interceptor for AI coding agents",
  "main": "src/agentwatch.js",
  "bin": {
    "agentwatch": "./bin/agentwatch.js",
    "spike": "./spike.js"
  },
  "scripts": {
